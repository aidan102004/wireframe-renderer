{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build sdl",
      "type": "shell",
      "command": "clang++",
      "args": [
        "-std=c++17",
        "-g",
        "${workspaceFolder}/main.cpp",
        "-o",
        "${workspaceFolder}/main",
        "-I/opt/homebrew/include",
        "-L/opt/homebrew/lib",
        "-lSDL2"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}